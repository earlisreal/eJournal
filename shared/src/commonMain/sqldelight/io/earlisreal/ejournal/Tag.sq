CREATE TABLE Tag (
    id         INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    portfolioId INTEGER NOT NULL,
    name       TEXT    NOT NULL,
    color      TEXT    NOT NULL            -- hex string, e.g. "#4CAF50"
);

-- Tag names are unique case-insensitively within a portfolio.
CREATE UNIQUE INDEX Tag_portfolio_name ON Tag(portfolioId, name COLLATE NOCASE);

selectAllTags:
SELECT * FROM Tag WHERE portfolioId = ? ORDER BY name COLLATE NOCASE ASC;

selectTagById:
SELECT * FROM Tag WHERE id = ? AND portfolioId = ?;

insertTag:
INSERT INTO Tag (portfolioId, name, color) VALUES (?, ?, ?);

updateTag:
UPDATE Tag SET name = ?, color = ? WHERE id = ? AND portfolioId = ?;

deleteTag:
DELETE FROM Tag WHERE id = ? AND portfolioId = ?;

deleteTagsForPortfolio:
DELETE FROM Tag WHERE portfolioId = ?;

lastInsertRowId:
SELECT last_insert_rowid();
